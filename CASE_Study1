    {
      "cell_type": "code",
      "source": [
        "# Separate features and target\n",
        "\n",
        "# NO = not readmitted\n",
        "# >30 and <30 = readmitted\n",
        "y = data[\"readmitted\"].map({\n",
        "    \"NO\": 0,\n",
        "    \">30\": 1,\n",
        "    \"<30\": 1\n",
        "})\n",
        "\n",
        "X = data.drop(\"readmitted\", axis=1)\n",
        "\n",
        "print(\"\\nNumber of features:\", X.shape[1])\n",
        "\n",
        "print(\"\\nTarget distribution:\")\n",
        "print(y.value_counts())"
